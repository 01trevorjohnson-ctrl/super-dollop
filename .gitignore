# Secrets — never commit these
homeassistant/secrets.yaml
homeassistant/google_service_account.json
docker/.env

# Home Assistant runtime state (created once HA actually runs against
# ./homeassistant as its config dir — not part of this repo's source)
homeassistant/.storage/
homeassistant/.cloud/
homeassistant/home-assistant.log*
homeassistant/home-assistant_v2.db*
homeassistant/tts/
homeassistant/blueprints/
homeassistant/deps/
homeassistant/tmp/

# HACS and other third-party custom integrations — downloaded, not source
homeassistant/custom_components/
homeassistant/.HA_VERSION
homeassistant/.ha_run.lock
homeassistant/.cache/

# Orphaned config dir from a previous container, not used by docker-compose.yml
/config/

.DS_Store
